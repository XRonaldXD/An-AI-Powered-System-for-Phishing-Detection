{
  "manifest_version": 3,
  "name": "AI-Powered Phishing Link Guard",
  "short_name": "Phishing Link Guard",
  "version": "1.0.0",
  "description": "Part of An AI-Powered System for Phishing Detection. Warns about suspicious links found on web pages and lets you manually analyze any URL for phishing risk.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Phishing Link Guard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/risk-engine.js", "lib/ml-model.js", "lib/url-features.js", "lib/trained-model-data.js", "lib/trained-model.js", "lib/scoring-adapter.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
